---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/site';
const regions = [
  { title: 'The Human Heartlands', label: 'Where a journey begins', text: 'In Millhaven, Stoneford and Greyfall Quarry, ordinary lives meet extraordinary events. Roads, river crossings and working settlements form the opening of the Human campaign.' },
  { title: 'Valecrown', label: 'Beyond the village roads', text: 'The Human campaign leads onward to Valecrown. Royal authority, contested accounts and the lives beyond the court become part of a story that reaches far beyond the Heartlands.' },
  { title: 'The Wider World', label: 'Eight civilizations', text: 'Mountain holds, woodland realms, grasslands and storm coasts are home to peoples with their own customs and histories. Ancient knowledge survives in different forms across the world.' },
  { title: 'The Shrouded Lands', label: 'A wounded homeland', text: 'At the centre of Theia’s troubled history lie the Shrouded Lands. Devastated by an ancient conflict and veiled from the wider world, they hold mysteries that generations have failed to settle.' },
];
---
<Base title="The World of Theia" description="Living civilizations, forgotten wonders and a past that refuses to stay buried." image="images/world-map-painterly.webp">
  <div class="world-page">
    <img class="world-backdrop" src={url('images/world-map-painterly.webp')} alt="An illustrated map of Theia: two great continents flank central lands concealed beneath a swirling dark shroud." width="1254" height="1254" fetchpriority="high" />
    <header class="world-heading wrap">
      <p class="eyebrow">Beyond the horizon</p>
      <h1>The World of Theia</h1>
      <p>Living civilizations, forgotten wonders and a past that refuses to stay buried.</p>
    </header>
    <div class="world-content wrap">
  <div class="prose"><p class="lead">Theia bears the scars of the Divine War. Its peoples have rebuilt, travelled and made new homes, even as fragments of an older world remain beneath their feet.</p><p>Two permanently opposed alliances—the Covenant and the Dominion—shape the modern world. Within their borders, life is more than war: villages work, cities grow, and every region has stories of its own.</p></div>
  <div class="content-grid">{regions.map((region) => <section class="content-panel"><p class="eyebrow">{region.label}</p><h2>{region.title}</h2><p>{region.text}</p></section>)}</div>
  <p class="note">A preview of Theia’s setting and planned campaign. The world is in development; final geography and playable regions will be shared as they are ready.</p>
  <div class="callout"><h2>A world seen through many eyes</h2><p>Every people carries a different part of Theia’s history.</p><Button href={url('races/')}>Meet the Peoples of Theia</Button></div>
    </div>
  </div>
</Base>

<style>
  .world-page { position: relative; isolation: isolate; overflow: clip; }
  /* Centre the map in the content bounds; cover crops excess ocean vertically on ultrawide screens. */
  .world-backdrop { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; pointer-events: none; mask-image: linear-gradient(to bottom, transparent, #000 10%, #000 76%, transparent 100%); }
  .world-heading { padding-block: 48px 28px; text-align: center; text-shadow: 0 2px 5px #031725; }
  .world-heading h1 { font-family: var(--display); font-size: clamp(36px, 5vw, 62px); color: #ffdda0; line-height: 1.15; margin-bottom: 18px; }
  .world-heading > p:last-child { max-width: 680px; margin-inline: auto; font-size: 22px; }
  .world-content { position: relative; padding-bottom: 70px; }
  .prose { padding: 28px 32px 12px; text-shadow: 0 2px 5px #031725, 0 0 16px #031725; }
  .content-panel { background: #031725e6; }
  .world-content > .note { text-align: center; max-width: 760px; margin-inline: auto; }
  .callout { background: radial-gradient(ellipse, #103047cc, #03172566); }
  @media (max-width: 900px) {
    .world-backdrop { top: 150px; bottom: auto; height: auto; }
  }
  @media (max-width: 600px) {
    .world-heading { padding-block: 38px 24px; }
    .world-heading > p:last-child { font-size: 20px; }
    .world-backdrop { top: 600px; }
    .prose { padding: 24px 22px 8px; }
    .world-content { padding-bottom: 45px; }
  }
</style>
