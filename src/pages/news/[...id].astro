---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedNews } from '../../lib/news';
import { url, formatDate } from '../../lib/site';
export async function getStaticPaths() {
  return (await publishedNews()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'news'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} image={post.data.image}>
  <article>
    <header class="article-header">
      <a class="article-back" href={url('news/')}>All news</a>
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <time class="metadata" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <p class="lead">{post.data.description}</p>
    </header>
    <img class="article-image" src={url(post.data.image)} alt={post.data.imageAlt} width="825" height="294" />
    <div class="article-body prose"><Content /><footer class="article-footer"><a href={url('news/')}>Explore more news from Theia</a></footer></div>
  </article>
</Base>
