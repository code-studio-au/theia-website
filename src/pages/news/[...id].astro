---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedNews } from '../../lib/news';
import { url, formatDate } from '../../lib/site';
export async function getStaticPaths() {
  return (await publishedNews()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'news'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} image={post.data.image}>
  <article>
    <header class="article-header">
      <a class="article-back" href={url('news/')}>All news</a>
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <time class="metadata" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <p class="lead">{post.data.description}</p>
    </header>
    <img class="article-image" src={url(post.data.image)} alt={post.data.imageAlt} width="825" height="294" />
    <div class="article-body prose"><Content /><footer class="article-footer"><a href={url('news/')}>Explore more news from Theia</a></footer></div>
  </article>
</Base>

<style>
  .article-image {
    display: block;
    width: 100%;
    max-width: none;
    height: clamp(240px, 33.333vw, 640px);
    aspect-ratio: auto;
    object-fit: cover;
    object-position: center;
    border: 0;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 78%, transparent);
  }
  .article-body :global(figure) {
    margin-inline: 0;
  }
  .article-body :global(img) {
    height: auto;
  }
  .article-body :global(figure a > img) {
    margin-block-end: 8px;
  }
  @media (max-width: 600px) {
    .article-image { object-position: 75% center; }
  }
</style>
