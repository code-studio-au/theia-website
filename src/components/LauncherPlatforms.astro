---
import Button from './Button.astro';
import { site, url } from '../lib/site';

interface Props {
  context?: 'public' | 'account';
}

const { context = 'public' } = Astro.props;
const inAccount = context === 'account';
const linuxInstaller = inAccount ? site.downloads.linux : '';
const Heading = inAccount ? 'h3' : 'h2';
const platforms = [
  { id: 'windows', name: 'Windows', status: 'Planned', description: 'A Windows installer is planned. Supported versions and requirements will be confirmed with a public release.' },
  {
    id: 'linux',
    name: 'Linux',
    status: inAccount && !linuxInstaller ? 'Unavailable' : 'Available - Pre-Alpha Testers Only',
    description: inAccount
      ? (linuxInstaller ? 'Install the Linux AMD64 launcher to download and update Theia.' : 'The Linux AMD64 launcher is temporarily unavailable.')
      : 'The Linux AMD64 launcher is available from your account after playtest approval.',
  },
  { id: 'macos', name: 'Mac', status: 'Planned', description: 'A macOS version is planned. Supported Mac models and system requirements will be confirmed with a future release.' },
] as const;
---
<div class:list={['content-grid', 'platform-grid', { 'account-platforms': inAccount }]}>
  {platforms.map((platform) => <section class:list={['content-panel', { 'linux-platform': platform.id === 'linux' }]}>
    <span class="status-label">{platform.status}</span>
    <Heading>{platform.name}</Heading>
    <p>{platform.description}</p>
    {platform.id === 'linux' && linuxInstaller
      ? <Button primary href={linuxInstaller}>Download Launcher</Button>
      : <button class:list={['button', 'launcher-button', { 'button-primary': platform.id === 'linux' }]} type="button" disabled><span>Download Launcher</span></button>}
    {platform.id === 'linux' && !inAccount && <p class="launcher-sign-in"><a href={url('account/')}>Sign in to your account</a></p>}
  </section>)}
</div>

<style>
  .platform-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .account-platforms { margin-block: 0; }
  .linux-platform {
    border-color: #c8a263;
    background: radial-gradient(ellipse at top, #b78a3420, transparent 70%), linear-gradient(135deg, #103246, #061f2e);
    box-shadow: 0 0 20px #c99a3814;
  }
  .linux-platform .status-label { color: #ffe2a1; border-color: #b99555; background: #b9955514; }
  .launcher-button { border: 0; color: inherit; font-family: inherit; }
  .launcher-button:disabled { opacity: .45; cursor: not-allowed; }
  .launcher-button:disabled:hover { filter: none; }
  .linux-platform .launcher-sign-in { margin: .85rem 0 0; }
  @media (max-width: 900px) {
    .platform-grid { grid-template-columns: 1fr; }
  }
</style>
